{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "paper",   "name": "Paper",   "color": "var(--tbe-paper)" },
				{ "slug": "surface", "name": "Surface", "color": "var(--tbe-surface)" },
				{ "slug": "ink",     "name": "Ink",     "color": "var(--tbe-ink)" },
				{ "slug": "muted",   "name": "Muted",   "color": "var(--tbe-muted)" },
				{ "slug": "accent",  "name": "Accent",  "color": "var(--tbe-accent)" },
				{ "slug": "rubric",  "name": "Rubric",  "color": "var(--tbe-rubric)" },
				{ "slug": "gold",    "name": "Gold",    "color": "var(--tbe-gold)" },
				{ "slug": "line",    "name": "Line",    "color": "var(--tbe-line)" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "manuscript",
					"name": "Manuscript serif",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, serif"
				},
				{
					"slug": "interface",
					"name": "Interface sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				}
			]
		},
		"layout": { "contentSize": "44rem", "wideSize": "72rem" },
		"spacing": { "units": ["px", "em", "rem", "%", "vw"] }
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manuscript)",
			"fontSize": "1.125rem",
			"lineHeight": "1.75"
		},
		"spacing": { "padding": { "left": "1.25rem", "right": "1.25rem" } },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": { "color": { "text": "var(--wp--preset--color--rubric)" } }
			},
			"heading": {
				"typography": { "fontWeight": "500", "lineHeight": "1.2", "letterSpacing": "0.005em" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--paper)"
				},
				"border": { "radius": "2px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--interface)", "fontSize": "0.9rem", "letterSpacing": "0.04em" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "tbe-reader", "title": "Bible reader", "postTypes": [] }
	]
}
