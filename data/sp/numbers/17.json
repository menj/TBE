","t":"r","mt":[2,4],"ds":"אל אהרנ קח את המחתה ותנ עליה אש מעל המזבח ושימ קטרת והלכ מהר אל העדה וכפר עליהמ כי יצא הקצפ מלפני","r":0,"u":0},{"k":"m","t":"r","mt":[5,8],"ds":"החל הנגפ","r":0,"u":0}],"12":[{"k":"m","t":"r","mt":[0,3],"ds":"ויקח אהרנ כאשר דבר משה וירצ","r":0,"u":0},{"k":"m","t":"r","mt":[4,11],"ds":"תוכ הקהל והנה החל הנגפ בעמ ויתנ את הקטרת ויכפר על העמ","r":0,"u":0}],"13":[{"k":"m","t":"r","mt":[0,10],"ds":"ויעמד בינ המיתימ ובינ החיימ ותעצר המגפה","r":0,"u":0}]}}